# Publisher PDFs and extracted text: copyrighted, never redistribute. Cite DOIs instead.
*.pdf
pdf_extract.txt

# Pickled models: version-fragile and an arbitrary-code-execution vector on load.
# Ship the training scripts, not the artifacts.
*.pkl
*.joblib

